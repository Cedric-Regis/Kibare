version: 1
formatters:
  precise:
    format: '%(asctime)s - %(name)s - %(lineno)d - %(levelname)s - %(request)s - %(message)s'
handlers:
  console:
    class: logging.StreamHandler
    formatter: precise
loggers:
  # Ne jamais journaliser le contenu des requêtes.
  synapse.storage.SQL:
    level: WARNING
  kibare_zero_clair:
    level: INFO
root:
  level: WARNING
  handlers: [console]
disable_existing_loggers: false
